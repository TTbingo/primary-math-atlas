  "modules": [
    {
      "id": "m1",
      "no": 1,
      "title": "数与代数",
      "short": "数",
      "desc": "从数数开始，一路走到分数、小数、百分数和负数；再把四则运算、数量关系、方程、比和比例串成一条线。",
      "strand": "数与运算 · 数量关系"
    },
    {
      "id": "m2",
      "no": 2,
      "title": "图形与几何",
      "short": "形",
      "desc": "先认图形，再量图形，最后算图形。长度、面积、体积是同一件事在三个维度上的展开。",
      "strand": "图形的认识与测量 · 图形的位置与运动"
    },
    {
      "id": "m3",
      "no": 3,
      "title": "统计与概率",
      "short": "统",
      "desc": "把一堆杂乱的数据变成看得懂的图表，用平均数概括整体，用可能性描述说不准的事。",
      "strand": "数据的收集、整理与表达 · 随机现象发生的可能性"
    },
    {
      "id": "m4",
      "no": 4,
      "title": "数学思考",
      "short": "思",
      "desc": "转化、数形结合、找规律、计数、抽屉原理——这些不是知识点，是解决问题的底层工具。",
      "strand": "综合与实践 · 数学思想方法"
    }
  ],
