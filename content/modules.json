  },
  {
   "id": "m3",
   "no": 3,
   "title": "统计与概率",
   "short": "统",
   "desc": "把一堆杂乱的数据变成看得懂的图表，用平均数概括整体，用可能性描述说不准的事。",
   "strand": "数据的收集、整理与表达 · 随机现象发生的可能性"
  },
  {
   "id": "m4",
   "no": 4,
   "title": "数学思考",
   "short": "思",
   "desc": "转化、数形结合、找规律、计数、抽屉原理——这些不是知识点，是解决问题的底层工具。",
   "strand": "综合与实践 · 数学思想方法"
  }
